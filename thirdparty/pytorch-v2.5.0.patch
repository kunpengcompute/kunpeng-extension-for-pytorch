diff --git a/cmake/Modules/FindKML.cmake b/cmake/Modules/FindKML.cmake
new file mode 100644
index 0000000..83496cd
--- /dev/null
+++ b/cmake/Modules/FindKML.cmake
@@ -0,0 +1,74 @@
+SET(KML_BLAS_INCLUDE_SEARCH_PATHS
+    $ENV{KMLROOT}/include
+)
+SET(KML_BLAS_LIB_SEARCH_PATHS
+    $ENV{KMLROOT}/lib/sme/kblas/multi/
+)
+
+FIND_PATH(KML_INCLUDE_DIR NAMES kblas.h PATHS ${KML_BLAS_INCLUDE_SEARCH_PATHS})
+FIND_LIBRARY(KML_LIB NAMES kblas PATHS ${KML_BLAS_LIB_SEARCH_PATHS})
+
+SET(KML_FOUND ON)
+# Check include files
+IF(NOT KML_INCLUDE_DIR)
+    SET(KML_FOUND OFF)
+    MESSAGE(STATUS "Could not find KBLAS include. Turning KBLAS_FOUND off")
+ENDIF()
+
+# Check libraries
+IF(NOT KML_LIB)
+    SET(KML_FOUND OFF)
+    MESSAGE(STATUS "Could not find KBLAS lib. Turning KBLAS_FOUND off")
+ENDIF()
+
+IF (KML_FOUND)
+    IF (NOT KML_FIND_QUIETLY)
+        MESSAGE(STATUS "Found KBLAS libraries: ${KML_LIB}")
+        MESSAGE(STATUS "Found KBLAS include: ${KML_INCLUDE_DIR}")
+    ENDIF (NOT KML_FIND_QUIETLY)
+ELSE (KML_FOUND)
+    IF (KML_FIND_REQUIRED)
+        MESSAGE(FATAL_ERROR "Could not find KBLAS")
+    ENDIF (KML_FIND_REQUIRED)
+ENDIF (KML_FOUND)
+
+MARK_AS_ADVANCED(
+    KML_INCLUDE_DIR
+    KML_LIB
+    KBLAS
+)
+
+include(CheckFunctionExists)
+
+IF(KML_FOUND)
+  SET(CMAKE_REQUIRED_LIBRARIES ${KML_LIB})
+  check_function_exists("sbgemm_" BLAS_HAS_SBGEMM)
+  check_function_exists("bgemm_" BLAS_HAS_BGEMM)
+  check_function_exists("hgemm16_" BLAS_HAS_HGEMM16)
+  check_function_exists("hgemv_" BLAS_HAS_HGEMV)
+  check_function_exists("igemm_" BLAS_HAS_IGEMM)
+  check_function_exists("igemv_" BLAS_HAS_IGEMV)
+  check_function_exists("ipacking_" BLAS_HAS_IPACKING)
+  IF(BLAS_HAS_SBGEMM)
+    add_compile_options(-DBLAS_HAS_SBGEMM)
+  ENDIF(BLAS_HAS_SBGEMM)
+  IF(BLAS_HAS_BGEMM)
+    add_compile_options(-DBLAS_HAS_BGEMM)
+  ENDIF(BLAS_HAS_BGEMM)
+  IF(BLAS_HAS_HGEMM16)
+    add_compile_options(-DBLAS_HAS_HGEMM16)
+  ENDIF(BLAS_HAS_HGEMM16)
+  IF(BLAS_HAS_HGEMV)
+    add_compile_options(-DBLAS_HAS_HGEMV)
+  ENDIF(BLAS_HAS_HGEMV)
+  IF(BLAS_HAS_IGEMM)
+    add_compile_options(-DBLAS_HAS_IGEMM)
+  ENDIF(BLAS_HAS_IGEMM)
+  IF(BLAS_HAS_IGEMV)
+    add_compile_options(-DBLAS_HAS_IGEMV)
+  ENDIF(BLAS_HAS_IGEMV)
+  IF(BLAS_HAS_IPACKING)
+    add_compile_options(-DBLAS_HAS_IPACKING)
+  ENDIF(BLAS_HAS_IPACKING)
+  SET(CMAKE_REQUIRED_LIBRARIES)
+ENDIF(KML_FOUND)
