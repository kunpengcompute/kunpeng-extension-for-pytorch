index 7911046..dbd69aa 100644
--- a/c10/core/impl/alloc_cpu.cpp
+++ b/c10/core/impl/alloc_cpu.cpp
@@ -8,6 +8,9 @@
 #include <c10/util/irange.h>
 #include <c10/util/numa.h>
 #include <cstring>
+#ifdef USE_HBW
+#include <kpmalloc.h>
+#endif
 
 #ifdef USE_MIMALLOC
 #include <mimalloc.h>
@@ -195,4 +198,44 @@ void c10_mi_free(void* p) {
 }
 } // namespace mi_malloc_wrapper
 #endif
+
+void* alloc_hbw(size_t nbytes) {
+#ifdef USE_HBW
+  if (nbytes == 0) {
+    return nullptr;
+  }
+  // We might have clowny upstream code that tries to alloc a negative number
+  // of bytes. Let's catch it early.
+  CAFFE_ENFORCE(
+      ((ptrdiff_t)nbytes) >= 0,
+      "alloc_hbw() seems to have been called with negative number: ",
+      nbytes);
+
+  // NOLINTNEXTLINE(cppcoreguidelines-init-variables)
+  void* data = kp_kupl_alloc(nbytes);
+
+  CHECK(
+      !FLAGS_caffe2_cpu_allocator_do_zero_fill ||
+      !FLAGS_caffe2_cpu_allocator_do_junk_fill)
+      << "Cannot request both zero-fill and junk-fill at the same time";
+  if (FLAGS_caffe2_cpu_allocator_do_zero_fill) {
+    memset(data, 0, nbytes);
+  } else if (FLAGS_caffe2_cpu_allocator_do_junk_fill) {
+    memset_junk(data, nbytes);
+  }
+
+  return data;
+#else
+  CAFFE_ENFORCE(false, "In alloc_hbw: HBW is not supported");
+  return nullptr;
+#endif
+}
+
+void free_hbw(void* data) {
+#ifdef USE_HBW
+  kp_free(data);
+#else
+  CAFFE_ENFORCE(false, "In free_hbw: HBW is not supported");
+#endif
+}
 } // namespace c10
