+struct C10_API HBWAllocator final : at::Allocator {
+  HBWAllocator() = default;
+  at::DataPtr allocate(size_t nbytes) override {
+    void* data = nullptr;
+    try {
+      data = c10::alloc_hbw(nbytes);
+    } catch (c10::Error& e) {
+      profiledCPUMemoryReporter().OutOfMemory(nbytes);
+      throw e;
+    }
+    profiledCPUMemoryReporter().New(data, nbytes);
+    return {data, data, &ReportAndDelete, at::Device(at::DeviceType::CPU, 1)};
+  }
+
+  void copy_data(void* dest, const void* src, std::size_t count) const override {
+      std::memcpy(dest, src, count);
+  }
+
+  static void ReportAndDelete(void* ptr) {
+    if (!ptr) {
+      return;
+    }
+    profiledCPUMemoryReporter().Delete(ptr);
+    free_hbw(ptr);
+  }
+
+  at::DeleterFnPtr raw_deleter() const override {
+    return &ReportAndDelete;
+  }
+};
+
 ProfiledCPUMemoryReporter& profiledCPUMemoryReporter() {
   static ProfiledCPUMemoryReporter reporter_;
   return reporter_;
@@ -160,6 +191,11 @@ at::Allocator* GetCPUAllocator() {
   return GetAllocator(DeviceType::CPU);
 }
 
+at::Allocator* GetHBWAllocator() {
+  static HBWAllocator g_hbw_cpu_alloc;
+  return &g_hbw_cpu_alloc;
+}
+
 void SetCPUAllocator(at::Allocator* alloc, uint8_t priority) {
   SetAllocator(DeviceType::CPU, alloc, priority);
 }
